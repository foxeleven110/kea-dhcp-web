# 构建阶段：静态编译，去除符号表
FROM golang:1.23-alpine AS build
WORKDIR /src

COPY go.mod ./
COPY main.go ./
COPY internal ./internal
COPY web ./web

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/kea-dhcp-go .

# 运行阶段：Alpine 最小镜像
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata \
    && adduser -D -u 10001 kea \
    && mkdir -p /app /data \
    && chown -R kea:kea /app /data
WORKDIR /app
COPY --from=build /out/kea-dhcp-go /app/kea-dhcp-go
COPY deploy/config.example.json /app/config.example.json

USER kea
ENV TZ=Asia/Shanghai \
    KEA_LISTEN=0.0.0.0:8080 \
    KEA_OPEN_BROWSER=false
EXPOSE 8080
VOLUME ["/data"]
ENTRYPOINT ["/app/kea-dhcp-go"]
CMD ["-config", "/data/config.json", "-open=false"]
